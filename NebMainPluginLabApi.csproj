        <Compile Include="API\SLRoles.cs" />
        <Compile Include="Commands\disableXP.cs" />
        <Compile Include="Commands\level.cs" />
        <Compile Include="Commands\playtime.cs" />
        <Compile Include="Commands\toggleadhsl.cs" />
        <Compile Include="Commands\TPTpost.cs" />
        <Compile Include="Commands\verify.cs" />
        <Compile Include="Config.cs" />
        <Compile Include="EventHandlers.cs" />
        <Compile Include="Main.cs" />
        <Compile Include="Properties\AssemblyInfo.cs" />
        <Compile Include="Systems\AutoFF\AutoFF.cs" />
        <Compile Include="Systems\Events\adhsl.cs" />
        <Compile Include="Systems\SpawnProtection\SpawnProtection.cs" />
        <Compile Include="Systems\WarteMusik\VolumeMode.cs" />
        <Compile Include="Systems\WarteMusik\WarteMusik.cs" />
        <Compile Include="Systems\RemoteKeycard\PlayerExtensions.cs" />
        <Compile Include="Systems\RemoteKeycard\RemoteKeycards.cs" />
        <Compile Include="Systems\CustomHints\EventHandlers.cs" />
        <Compile Include="Systems\CustomHints\Hints.cs" />
        <Compile Include="Systems\Database\BadgeConsoleSilencer.cs" />
        <Compile Include="Systems\Database\Database.cs" />
        <Compile Include="Systems\Database\SessionVariables.cs" />
        <Compile Include="Systems\Database\XP\Level.cs" />
        <Compile Include="Systems\Database\XP\XP.cs" />
        <Compile Include="Systems\Discord\Discord.cs" />
        <Compile Include="Systems\Discord\WeeklyPlaytime.cs" />
        <Compile Include="Systems\Settings\EventHandles.cs" />
        <Compile Include="Systems\Settings\Handlers.cs" />
    </ItemGroup>
    <ItemGroup>
      <None Include="packages.config" />
    </ItemGroup>


    <ItemGroup>
      <PackageReference Include="Lib.Harmony" Version="2.2.2" />
      <PackageReference Include="Discord.Net.Core" Version="3.18.0" />
      <PackageReference Include="Discord.Net.Rest" Version="3.18.0" />
      <PackageReference Include="Discord.Net.Webhook" Version="3.18.0" />
      <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="6.0.0" />
      <PackageReference Include="MongoDB.Bson" Version="3.6.0" />
      <PackageReference Include="MongoDB.Driver" Version="3.6.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="NLayer" Version="1.16.0" />
      <PackageReference Include="RueI" Version="3.1.2" />
      <PackageReference Include="System.Buffers" Version="4.5.1" />
      <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
      <PackageReference Include="System.Interactive.Async" Version="6.0.1" />
      <PackageReference Include="System.Linq.Async" Version="6.0.1" />
      <PackageReference Include="System.Memory" Version="4.5.5" />
      <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
      <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
      <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
      <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    </ItemGroup>


    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />


    <PropertyGroup>
        <DistDir>dist\</DistDir>
    </PropertyGroup>

    <ItemGroup>
        <PluginAssembly Include="$(AssemblyName)" />
        <PluginAssembly Include="RueI" />
    </ItemGroup>

    <ItemGroup>
        <NonDeployable Include="Microsoft.Win32.Registry" />
        <NonDeployable Include="System.IO" />
        <NonDeployable Include="System.Runtime" />
        <NonDeployable Include="System.Runtime.InteropServices.RuntimeInformation" />
        <NonDeployable Include="System.Security.AccessControl" />
        <NonDeployable Include="System.Security.Cryptography.Algorithms" />
        <NonDeployable Include="System.Security.Cryptography.Encoding" />
        <NonDeployable Include="System.Security.Cryptography.Primitives" />
        <NonDeployable Include="System.Security.Cryptography.X509Certificates" />
        <NonDeployable Include="System.Security.Principal.Windows" />
        <NonDeployable Include="System.ValueTuple" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="README.md" />
    </ItemGroup>

    <Target Name="BuildDist" AfterTargets="Build">
        <ItemGroup>
            <ServerProvided Include="libs\*.dll" />
        </ItemGroup>
        <ItemGroup>
            <DistDependency Include="$(OutputPath)*.dll" />
            <DistDependency Remove="@(PluginAssembly->'$(OutputPath)%(Identity).dll')" />
            <DistDependency Remove="@(ServerProvided->'$(OutputPath)%(Filename).dll')" />
            <DistDependency Remove="@(NonDeployable->'$(OutputPath)%(Identity).dll')" />
        </ItemGroup>

        <RemoveDir Directories="$(DistDir)" />
        <Copy SourceFiles="@(PluginAssembly->'$(OutputPath)%(Identity).dll')"
              DestinationFolder="$(DistDir)plugins\global" />
        <Copy SourceFiles="@(DistDependency)"
              DestinationFolder="$(DistDir)dependencies\global" />
        <Message Importance="high"
                 Text="Deploy-Layout: $(DistDir) (@(DistDependency->Count()) Dependencies)" />
    </Target>

</Project>
